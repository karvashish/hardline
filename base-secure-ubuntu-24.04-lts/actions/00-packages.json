{
  "steps": [
    {
      "id": "packages-base-secure",
      "type": "packages",
      "severity": "high",
      "risk_class": "availability",
      "control_tags": [],
      "packages": {
        "update": true,
        "upgrade": true,
        "autoremove": true,
        "install": [
          "nftables",
          "auditd",
          "fail2ban",
          "unattended-upgrades"
        ],
        "purge": [
          "telnet",
          "rsh-client",
          "ftp",
          "tftp",
          "cups",
          "rpcbind",
          "nfs-common",
          "snapd",
          "whoopsie",
          "apport",
          "landscape-client"
        ]
      }
    }
  ]
}
