{
  "steps": [
    {
      "id": "ssh-template-apply",
      "type": "template",
      "severity": "medium",
      "risk_class": "access",
      "control_tags": [],
      "template": {
        "src": "templates/10-ssh-sshd-config.tmpl",
        "dest": "/etc/ssh/sshd_config.d/99-hardline-ssh.conf",
        "mode": "0600"
      }
    },
    {
      "id": "ssh-config-validate",
      "type": "validate",
      "severity": "medium",
      "risk_class": "access",
      "control_tags": [],
      "validate": "sshd"
    },
    {
      "id": "ssh-service-reload",
      "type": "service",
      "severity": "critical",
      "risk_class": "access",
      "control_tags": [],
      "service": {
        "name": "ssh",
        "enabled": true,
        "state": "reloaded"
      }
    }
  ]
}
