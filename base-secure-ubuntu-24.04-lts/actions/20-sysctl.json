{
  "steps": [
    {
      "id": "sysctl-hardening-template",
      "plugin": "template",
      "severity": "medium",
      "risk_class": "availability",
      "control_tags": [],
      "config": {
        "src": "templates/20-sysctl-hardening.conf.tmpl",
        "dest": "/etc/sysctl.d/99-hardline-hardening.conf",
        "mode": "0644"
      }
    },
    {
      "id": "sysctl-apply",
      "plugin": "service",
      "severity": "critical",
      "risk_class": "availability",
      "control_tags": [],
      "config": {
        "name": "systemd-sysctl",
        "state": "restarted"
      }
    }
  ]
}
