{
  "steps": [
    {
      "id": "firewall-default-deny",
      "type": "firewall",
      "severity": "high",
      "risk_class": "access_critical",
      "control_tags": [],
      "firewall": {
        "backend": "nftables",
        "policy": "drop",
        "template_src": "templates/30-firewall-nftables-base.tmpl",
        "template_dest": "/etc/nftables.d/99-hardline-firewall.nft",
        "allow": [
          {
            "port": 22,
            "proto": "tcp"
          }
        ]
      }
    },
    {
      "id": "firewall-config-validate",
      "type": "validate",
      "severity": "high",
      "risk_class": "access_critical",
      "control_tags": [],
      "validate": "firewall"
    },
    {
      "id": "firewall-service-restart",
      "type": "service",
      "severity": "high",
      "risk_class": "access_critical",
      "control_tags": [],
      "service": {
        "name": "nftables",
        "enabled": true,
        "state": "restarted"
      }
    }
  ]
}
