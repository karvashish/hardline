{
  "steps": [
    {
      "id": "auditd-rules-template",
      "type": "template",
      "severity": "medium",
      "risk_class": "compliance",
      "control_tags": [],
      "template": {
        "src": "templates/40-audit-hardening-rules.tmpl",
        "dest": "/etc/audit/rules.d/99-hardline.rules",
        "mode": "0640"
      }
    },
    {
      "id": "auditd-service-enable",
      "type": "service",
      "severity": "high",
      "risk_class": "compliance",
      "control_tags": [],
      "service": {
        "name": "auditd",
        "enabled": true,
        "state": "started"
      }
    }
  ]
}
