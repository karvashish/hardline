{
  "steps": [
    {
      "id": "journald-configure-persistence",
      "type": "template",
      "severity": "medium",
      "risk_class": "non_access_critical",
      "control_tags": [],

      "template": {
        "src": "templates/50-journald-hardening.conf.tmpl",
        "dest": "/etc/systemd/journald.conf.d/99-hardline.conf",
        "mode": "0644"
      }
    },
    {
      "id": "journald-reload",
      "type": "service",
      "severity": "medium",
      "risk_class": "non_access_critical",
      "control_tags": [],

      "service": {
        "name": "systemd-journald",
        "enabled": true,
        "state": "restarted"
      }
    }
  ]
}
