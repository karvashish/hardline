{
  "steps": [
    {
      "id": "itest-force-template-apply",
      "plugin": "template",
      "severity": "low",
      "risk_class": "integrity",
      "control_tags": [],
      "config": {
        "src": "templates/10-managed.conf.tmpl",
        "dest": "/etc/hardline.d/99-hardline-itest-force-rollback.conf",
        "mode": "0644"
      }
    },
    {
      "id": "itest-force-firewall-template-apply",
      "plugin": "firewall_template",
      "severity": "high",
      "risk_class": "access",
      "control_tags": [],
      "config": {
        "backend": "nftables",
        "policy": "drop",
        "template_src": "templates/20-firewall-template.tmpl",
        "template_dest": "/etc/nftables.d/99-hardline-itest-force-rollback.nft",
        "allow": [
          {
            "port": 2022,
            "proto": "tcp"
          }
        ]
      }
    },
    {
      "id": "itest-force-firewall-service-restart",
      "plugin": "service",
      "severity": "medium",
      "risk_class": "access",
      "control_tags": [],
      "config": {
        "name": "nftables",
        "enabled": true,
        "state": "restarted"
      }
    },
    {
      "id": "itest-force-ssh-template-apply",
      "plugin": "template",
      "severity": "high",
      "risk_class": "access",
      "control_tags": [],
      "config": {
        "src": "templates/30-ssh-invalid.tmpl",
        "dest": "/etc/ssh/sshd_config.d/99-hardline-itest-ssh-bad.conf",
        "mode": "0600"
      }
    },
    {
      "id": "itest-force-ssh-service-reload",
      "plugin": "service",
      "severity": "critical",
      "risk_class": "access",
      "control_tags": [],
      "config": {
        "name": "ssh",
        "enabled": true,
        "state": "reloaded"
      }
    }
  ]
}
