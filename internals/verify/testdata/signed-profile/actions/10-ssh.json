{
  "steps": [
    {
      "id": "itest-ssh-template-apply",
      "plugin": "template",
      "config": {
        "src": "templates/10-ssh-sshd-config.tmpl",
        "dest": "/etc/ssh/sshd_config.d/99-hardline-itest-ssh.conf",
        "mode": "0600"
      }
    },
    {
      "id": "itest-ssh-service-reload",
      "plugin": "service",
      "config": {
        "name": "ssh",
        "enabled": true,
        "state": "reloaded"
      }
    }
  ]
}
