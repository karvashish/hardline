{
  "steps": [
    {
      "id": "sshd-config-perms",
      "plugin": "file_meta",
      "config": {
        "path": "/etc/ssh/sshd_config",
        "mode": "0600",
        "owner": "root",
        "group": "root"
      }
    },
    {
      "id": "ssh-policy",
      "plugin": "ssh",
      "config": {
        "path": "/etc/ssh/sshd_config.d/00-hardline-demo.conf",
        "mode": "0600",
        "service": "ssh",
        "settings": {
          "AllowAgentForwarding": "no",
          "LogLevel": "VERBOSE",
          "MaxAuthTries": 4,
          "PasswordAuthentication": "no",
          "PermitRootLogin": "no",
          "X11Forwarding": "no"
        }
      }
    },
    {
      "id": "ssh-service-enabled",
      "plugin": "service",
      "config": {
        "name": "ssh",
        "enabled": true
      }
    }
  ]
}
