{
  "$defs": {
    "ActionFile": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "audit"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "dest": {
                    "pattern": "^[A-Za-z0-9._/-]+$",
                    "type": "string"
                  },
                  "mode": {
                    "pattern": "^[0-7]{3,4}$",
                    "type": "string"
                  },
                  "src": {
                    "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|[.][A-Za-z0-9_-][A-Za-z0-9._-]*|[.][.][A-Za-z0-9._-]+)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|[.][A-Za-z0-9_-][A-Za-z0-9._-]*|[.][.][A-Za-z0-9._-]+))*$",
                    "type": "string"
                  }
                },
                "required": [
                  "src",
                  "dest",
                  "mode"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "file_meta"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "append_only": {
                    "type": "boolean"
                  },
                  "group": {
                    "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]{0,31}$",
                    "type": "string"
                  },
                  "immutable": {
                    "type": "boolean"
                  },
                  "mode": {
                    "pattern": "^[0-7]{3,4}$",
                    "type": "string"
                  },
                  "owner": {
                    "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]{0,31}$",
                    "type": "string"
                  },
                  "path": {
                    "pattern": "^[A-Za-z0-9._/@-]+$",
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "firewall"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "backend": {
                    "enum": [
                      "nftables"
                    ],
                    "type": "string"
                  },
                  "family": {
                    "enum": [
                      "inet",
                      "ip",
                      "ip6"
                    ],
                    "type": "string"
                  },
                  "main_config": {
                    "enum": [
                      "/etc/nftables.conf",
                      "/etc/sysconfig/nftables.conf"
                    ],
                    "type": "string"
                  },
                  "managed_dest": {
                    "pattern": "^[A-Za-z0-9._/-]+$",
                    "type": "string"
                  },
                  "policies": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "chain": {
                          "enum": [
                            "input",
                            "output",
                            "forward"
                          ],
                          "type": "string"
                        },
                        "policy": {
                          "enum": [
                            "accept",
                            "drop"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "chain",
                        "policy"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "rules": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "action": {
                          "enum": [
                            "accept",
                            "drop",
                            "reject"
                          ],
                          "type": "string"
                        },
                        "chain": {
                          "enum": [
                            "input",
                            "output",
                            "forward"
                          ],
                          "type": "string"
                        },
                        "ct_states": {
                          "items": {
                            "enum": [
                              "new",
                              "established",
                              "related",
                              "invalid",
                              "untracked"
                            ],
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "destination": {
                          "pattern": "^$|^[0-9A-Fa-f:.]{1,45}(/[0-9]{1,3})?$",
                          "type": "string"
                        },
                        "in_interface": {
                          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$",
                          "type": "string"
                        },
                        "out_interface": {
                          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$",
                          "type": "string"
                        },
                        "port": {
                          "maximum": 65535,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "ports": {
                          "items": {
                            "maximum": 65535,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "type": "array"
                        },
                        "proto": {
                          "enum": [
                            "",
                            "tcp",
                            "udp",
                            "icmp",
                            "icmpv6"
                          ],
                          "type": "string"
                        },
                        "source": {
                          "pattern": "^$|^[0-9A-Fa-f:.]{1,45}(/[0-9]{1,3})?$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "chain",
                        "action"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "table": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
                    "type": "string"
                  }
                },
                "required": [
                  "main_config"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "firewall_template"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "allow": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "port": {
                          "maximum": 65535,
                          "minimum": 1,
                          "type": "integer"
                        },
                        "proto": {
                          "enum": [
                            "tcp",
                            "udp"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "port",
                        "proto"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "backend": {
                    "enum": [
                      "nftables"
                    ],
                    "type": "string"
                  },
                  "main_config": {
                    "enum": [
                      "/etc/nftables.conf",
                      "/etc/sysconfig/nftables.conf"
                    ],
                    "type": "string"
                  },
                  "managed_dest": {
                    "pattern": "^[A-Za-z0-9._/-]+$",
                    "type": "string"
                  },
                  "policy": {
                    "enum": [
                      "allow",
                      "deny",
                      "reject",
                      "drop"
                    ],
                    "type": "string"
                  },
                  "template_dest": {
                    "pattern": "^[A-Za-z0-9._/-]+$",
                    "type": "string"
                  },
                  "template_src": {
                    "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|[.][A-Za-z0-9_-][A-Za-z0-9._-]*|[.][.][A-Za-z0-9._-]+)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|[.][A-Za-z0-9_-][A-Za-z0-9._-]*|[.][.][A-Za-z0-9._-]+))*$",
                    "type": "string"
                  }
                },
                "required": [
                  "main_config"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "packages_apt"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "autoremove": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  },
                  "install": {
                    "items": {
                      "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "purge": {
                    "items": {
                      "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "purge_also_removes": {
                    "items": {
                      "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "update": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  },
                  "upgrade": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "packages_dnf4"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "autoremove": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  },
                  "install": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "purge": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "purge_also_removes": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "update": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  },
                  "upgrade": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "packages_dnf5"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "autoremove": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  },
                  "install": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "purge": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "purge_also_removes": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "update": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  },
                  "upgrade": {
                    "pattern": "^(never|always|once|if_[1-9][0-9]*[hdw]_since_last)$",
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "service"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "name": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$",
                    "type": "string"
                  },
                  "restart_policy": {
                    "additionalProperties": false,
                    "properties": {
                      "steps": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "type": {
                        "enum": [
                          "always",
                          "on_change"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "type": "object"
                  },
                  "state": {
                    "enum": [
                      "started",
                      "stopped",
                      "restarted",
                      "reloaded",
                      "reload-or-restart"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plugin": {
                "const": "template"
              }
            },
            "required": [
              "plugin"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "additionalProperties": false,
                "properties": {
                  "dest": {
                    "pattern": "^[A-Za-z0-9._/-]+$",
                    "type": "string"
                  },
                  "mode": {
                    "pattern": "^[0-7]{3,4}$",
                    "type": "string"
                  },
                  "src": {
                    "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|[.][A-Za-z0-9_-][A-Za-z0-9._-]*|[.][.][A-Za-z0-9._-]+)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|[.][A-Za-z0-9_-][A-Za-z0-9._-]*|[.][.][A-Za-z0-9._-]+))*$",
                    "type": "string"
                  }
                },
                "required": [
                  "src",
                  "dest",
                  "mode"
                ]
              }
            },
            "required": [
              "config"
            ]
          }
        }
      ],
      "properties": {
        "allow_unvalidated": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "plugin"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/karvashish/hardline/pkg/profile/action-file",
  "$ref": "#/$defs/ActionFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
