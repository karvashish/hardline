{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karvashish/hardline/pkg/profile/action-file",
  "$ref": "#/$defs/ActionFile",
  "$defs": {
    "ActionFile": {
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "steps"
      ]
    },
    "Step": {
      "properties": {
        "id": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "medium"
        },
        "risk_class": {
          "type": "string",
          "enum": [
            "none",
            "access",
            "availability",
            "data_loss",
            "integrity",
            "compliance",
            "other"
          ],
          "description": "Class of possible worst-case consequence if the step fails or is misconfigured (e.g. losing SSH access, outage/availability issue, data loss, or compliance breach).",
          "default": "none"
        },
        "control_tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "config": {
          "type": "object"
        },
        "allow_unvalidated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "plugin",
        "severity",
        "risk_class",
        "control_tags"
      ]
    }
  }
}
