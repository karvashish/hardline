{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hardline Profile",
  "type": "object",
  "required": [
    "id",
    "version",
    "os",
    "profile_schema",
    "min_hardline",
    "actions",
    "templates"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "os": { "type": "string" },
    "profile_schema": { "type": "integer" },
    "min_hardline": { "type": "string" },
    "actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "templates": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
