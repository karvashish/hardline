{
  "steps": [
    {
      "id": "auditd-service-enable",
      "plugin": "service",
      "config": {
        "name": "auditd",
        "enabled": true,
        "state": "started"
      }
    },
    {
      "id": "auditd-rules",
      "plugin": "audit",
      "config": {
        "src": "templates/40-audit-hardening-rules.tmpl",
        "dest": "/etc/audit/rules.d/99-hardline.rules",
        "mode": "0640"
      }
    }
  ]
}
